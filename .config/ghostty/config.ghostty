# Ghostty config
# Lives at ~/.config/ghostty/config.ghostty on macOS and Linux.
# Reload with Cmd+Shift+, (macOS) or Ctrl+Shift+, (Linux).
# background-opacity needs a full restart on macOS.

# --- Font -------------------------------------------------------------------
# Monaco Nerd Font Mono ships in this repo (resources/fonts/) and is installed
# by scripts/fonts_init.sh.
font-family = Monaco Nerd Font Mono
font-size = 12

# --- Terminal behavior ------------------------------------------------------
cursor-style-blink = false
# Bytes per terminal (default 10 MB).
scrollback-limit = 100000000
# Initial window size in cells.
window-width = 80
window-height = 25
# Do not prompt when closing a tab/split with a running process.
confirm-close-surface = false
# Hide the mouse pointer while typing (Ghostty default is false).
# It comes back as soon as the mouse moves.
mouse-hide-while-typing = true

# --- Startup ----------------------------------------------------------------
# Open new windows in ~/Workspace.
working-directory = ~/Workspace

# --- Colors -----------------------------------------------------------------
# Ghostty's default background is dark gray (#282c34), and the gray tints
# everything behind the transparent window, so use black.
background = #000000

# --- Transparency -----------------------------------------------------------
# 80% opaque (20% transparent).
background-opacity = 0.8
# Cells with an explicit background color (vim/tmux status bars, etc.) are
# transparent too. Set to false to keep colored cells solid.
background-opacity-cells = true

# --- Blur -------------------------------------------------------------------
# Blur off. `true` = Ghostty default intensity 20, or use a small integer
# (e.g. 2) for a light blur.
background-blur = false

# --- Background image -------------------------------------------------------
# Off. To enable, uncomment and set a path.
# background-image = ~/Pictures/terminal-bg.png
# background-image-fit = stretch
# background-image-opacity = 0.5

# --- OS-specific ------------------------------------------------------------
# Loaded last. scripts/zsh_init.sh installs config_linux.ghostty next to this
# file as config_os.ghostty on Linux; macOS has none, and the leading ? keeps a
# missing file silent.
config-file = ?config_os.ghostty
