# Linux-only Ghostty settings, installed as ~/.config/ghostty/config_os.ghostty
# by scripts/zsh_init.sh and pulled in by config.ghostty.
# These keybinds assume keyd's Cmd->Ctrl remap, so they must not load on macOS.

# Mac-style clipboard keys (Cmd = Super on this keyboard)
keybind = super+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard

# Mac-style tabs and splits
# keyd sends Cmd as Ctrl, so Cmd+T arrives here as ctrl+t
keybind = ctrl+t=new_tab
keybind = super+t=new_tab
keybind = ctrl+shift+t=unbind
# Cmd+W -> close tab. Cmd+W arrives as ctrl+w, which is also ^W (delete word,
# vim window prefix), so keyd sends the physical Ctrl+W as ctrl+alt+w and the
# second bind turns that back into the real control character.
keybind = ctrl+w=close_tab
keybind = ctrl+alt+w=text:\x17
# Cmd+N -> new window
keybind = ctrl+n=new_window
# Cmd+Shift+[ / ] and Cmd+1-9 switch tabs
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+shift+right_bracket=next_tab
keybind = ctrl+one=goto_tab:1
keybind = ctrl+two=goto_tab:2
keybind = ctrl+three=goto_tab:3
keybind = ctrl+four=goto_tab:4
keybind = ctrl+five=goto_tab:5
keybind = ctrl+six=goto_tab:6
keybind = ctrl+seven=goto_tab:7
keybind = ctrl+eight=goto_tab:8
keybind = ctrl+nine=goto_tab:9
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Claude Code uses Ctrl+Enter (queue a message while it works); Ghostty's
# default binds it to toggle_fullscreen, which swallows the key. Free it so the
# terminal passes it through.
keybind = ctrl+enter=unbind
