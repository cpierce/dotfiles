# Machine-specific hosts live in ~/.ssh/config_local (not in this repo).
Include config_local

# 1Password SSH agent, when the desktop app is installed (not on WSL)
Match exec "test -S %d/.1password/agent.sock"
  IdentityAgent ~/.1password/agent.sock

Host *
  AddKeysToAgent yes
  ForwardAgent yes
  ServerAliveInterval 55
  ServerAliveCountMax 4
  # Remote hosts rarely have Ghostty's xterm-ghostty terminfo
  SetEnv TERM=xterm-256color
