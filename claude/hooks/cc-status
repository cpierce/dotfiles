#!/bin/sh
# Claude Code hook target. iTerm2 ships a `cc-status` utility that paints
# session state into the tab/status bar; it only exists on macOS. Forward to it
# when present, otherwise exit cleanly so the same settings.json works on Linux.
bin="$HOME/.config/iterm2/cc-status"
[ -x "$bin" ] && exec "$bin" "$@"
exit 0
