#!/bin/sh
# open — macOS-style `open` for Linux: hand files, folders and URLs to their default app.
#   open            open the current folder
#   open a.pdf b/   open several things at once
#   open -R file    reveal: open the folder that contains file

reveal=0
case "$1" in
  -h|--help) sed -n '2,5s/^# \{0,1\}//p' "$0"; exit 0 ;;
  -R) reveal=1; shift ;;
esac

[ $# -eq 0 ] && set -- .

status=0
for target in "$@"; do
  case "$target" in
    *://*|mailto:*) ;;
    *)
      if [ ! -e "$target" ]; then
        echo "open: $target: No such file or directory" >&2
        status=1
        continue
      fi
      [ "$reveal" -eq 1 ] && target=$(dirname -- "$target")
      ;;
  esac
  setsid -f xdg-open "$target" >/dev/null 2>&1
done
exit $status
